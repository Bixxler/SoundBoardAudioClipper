<Window x:Class="Soundboard.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename sound" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1E1F24" Foreground="#E8E8EC" FontFamily="Segoe UI" FontSize="13"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="16">
        <TextBlock Text="Name" Foreground="#A6A8B3" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" Padding="6,4" MaxLength="64" TextChanged="NameBox_TextChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="Rename" IsDefault="True" Padding="14,5" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Padding="14,5" />
        </StackPanel>
    </StackPanel>
</Window>
