<Window x:Class="Soundboard.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename sound" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="20">
        <TextBlock Text="Name" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" MaxLength="64" TextChanged="NameBox_TextChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" Content="Rename" IsDefault="True" Padding="16,6" Margin="0,0,8,0"
                    Style="{DynamicResource AccentButtonStyle}" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Padding="16,6" />
        </StackPanel>
    </StackPanel>
</Window>
