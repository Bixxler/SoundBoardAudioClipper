<Window x:Class="Soundboard.ClipEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Soundboard"
        Title="Make a clip" Width="860" Height="460" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Closed="Window_Closed">
    <DockPanel Margin="20">
        <TextBlock x:Name="Description" DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,14" />

        <!-- Name and save -->
        <Border DockPanel.Dock="Bottom" Margin="-20,16,-20,-20" Padding="20,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="ClipName" Grid.Column="1" MaxLength="64" Margin="0,0,16,0" VerticalContentAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="PrimaryButton" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Margin="0,0,8,0"
                            Click="Primary_Click" />
                    <Button Content="Save MP3…" Padding="14,6" Margin="0,0,8,0" Click="SaveMp3_Click" />
                    <Button Content="Close" Padding="14,6" Click="Close_Click" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transport and selection info -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Height="32" Padding="12,0" Margin="0,0,8,0" Click="Play_Click" ToolTip="Plays on your own output only">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Play selection" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Width="32" Height="32" Padding="0" Margin="0,0,16,0" Click="Stop_Click" ToolTip="Stop">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" />
                </Button>
                <Button Content="Last 4 s" Height="32" Padding="12,0" Margin="0,0,8,0" Click="SelectLast_Click" ToolTip="Select the last 4 seconds" />
                <Button Content="All" Height="32" Padding="12,0" Click="SelectAll_Click" ToolTip="Select everything" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock x:Name="SelectionText" FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock x:Name="FitText" Style="{StaticResource Hint}" TextAlignment="Right" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <local:WaveformView x:Name="Waveform" MinHeight="140" />
        </Border>
    </DockPanel>
</Window>
