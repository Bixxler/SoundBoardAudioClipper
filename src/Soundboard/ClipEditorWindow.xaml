<Window x:Class="Soundboard.ClipEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Soundboard"
        Title="Make a clip" Width="1020" Height="660" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Closed="Window_Closed">
    <DockPanel Margin="20">
        <TextBlock x:Name="Description" DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,14" />

        <!-- Name and save -->
        <Border DockPanel.Dock="Bottom" Margin="-20,16,-20,-20" Padding="20,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="ClipName" Grid.Column="1" MaxLength="64" Margin="0,0,16,0" VerticalContentAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="PrimaryButton" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Margin="0,0,8,0"
                            Click="Primary_Click" />
                    <Button Content="Save MP3…" Padding="14,6" Margin="0,0,8,0" Click="SaveMp3_Click" />
                    <Button Content="Close" Padding="14,6" Click="Close_Click" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transport and selection info -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Height="32" Padding="12,0" Margin="0,0,8,0" Click="Play_Click" ToolTip="Plays on your own output only">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Play selection" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Width="32" Height="32" Padding="0" Margin="0,0,16,0" Click="Stop_Click" ToolTip="Stop">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" />
                </Button>
                <Button Content="Last 4 s" Height="32" Padding="12,0" Margin="0,0,8,0" Click="SelectLast_Click" ToolTip="Select the last 4 seconds" />
                <Button Content="All" Height="32" Padding="12,0" Margin="0,0,16,0" Click="SelectAll_Click" ToolTip="Select everything" />
                <ToggleButton x:Name="ReverseToggle" Height="32" Padding="12,0" Checked="Reverse_Changed" Unchecked="Reverse_Changed"
                              ToolTip="Play the clip backwards. Click again to undo.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Reverse" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock x:Name="SelectionText" FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock x:Name="FitText" Style="{StaticResource Hint}" TextAlignment="Right" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Effects: applied to the selection when previewing and saving -->
        <Border DockPanel.Dock="Right" Width="250" Margin="16,0,0,0" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,10,14,12">
                <DockPanel>
                    <Button x:Name="ResetEffectsButton" DockPanel.Dock="Right" Content="Reset" Padding="10,3" Click="ResetEffects_Click"
                            ToolTip="Turn every effect off" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Effects" />
                </DockPanel>
                <DockPanel Margin="0,10,0,0" ToolTip="Louder or quieter. Loud clips are kept from clipping.">
                    <TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Volume" />
                </DockPanel>
                <Slider x:Name="VolumeSlider" Minimum="-12" Maximum="12" Value="0" TickFrequency="1"
                        IsSnapToTickEnabled="True" ValueChanged="Effect_Changed" ToolTip="Louder or quieter. Loud clips are kept from clipping." />
                <DockPanel Margin="0,6,0,0" ToolTip="Boosts the low end, below about 120 Hz">
                    <TextBlock x:Name="BassValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Bass boost" />
                </DockPanel>
                <Slider x:Name="BassSlider" Minimum="0" Maximum="18" Value="0" TickFrequency="1"
                        IsSnapToTickEnabled="True" ValueChanged="Effect_Changed" ToolTip="Boosts the low end, below about 120 Hz" />
                <DockPanel Margin="0,6,0,0" ToolTip="In semitones. Like a tape: higher is also faster, lower is also slower.">
                    <TextBlock x:Name="PitchValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Pitch" />
                </DockPanel>
                <Slider x:Name="PitchSlider" Minimum="-12" Maximum="12" Value="0" TickFrequency="1"
                        IsSnapToTickEnabled="True" ValueChanged="Effect_Changed" ToolTip="In semitones. Like a tape: higher is also faster, lower is also slower." />
                <DockPanel Margin="0,6,0,0" ToolTip="Room echo. Adds a short tail to the end of the clip.">
                    <TextBlock x:Name="ReverbValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Reverb" />
                </DockPanel>
                <Slider x:Name="ReverbSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5"
                        IsSnapToTickEnabled="True" ValueChanged="Effect_Changed" ToolTip="Room echo. Adds a short tail to the end of the clip." />
                <DockPanel Margin="0,6,0,0" ToolTip="Repeats that fade out. Adds a short tail to the end of the clip.">
                    <TextBlock x:Name="EchoValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Echo" />
                </DockPanel>
                <Slider x:Name="EchoSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5"
                        IsSnapToTickEnabled="True" ValueChanged="Effect_Changed" ToolTip="Repeats that fade out. Adds a short tail to the end of the clip." />
                <DockPanel Margin="0,6,0,0" ToolTip="Crunchy, overdriven sound">
                    <TextBlock x:Name="DistortionValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Distortion" />
                </DockPanel>
                <Slider x:Name="DistortionSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5"
                        IsSnapToTickEnabled="True" ValueChanged="Effect_Changed" ToolTip="Crunchy, overdriven sound" />
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <local:WaveformView x:Name="Waveform" MinHeight="140" />
        </Border>
    </DockPanel>
</Window>
