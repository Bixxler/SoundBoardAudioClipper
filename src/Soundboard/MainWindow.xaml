<Window x:Class="Soundboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Soundboard"
        Title="Soundboard" Height="860" Width="1060" MinWidth="780" MinHeight="560"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Sidebar: routing and clip recorder ================= -->
        <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- Fills the visible height, so the app list can grow into it. Below MinHeight, the sidebar scrolls instead. -->
            <Grid Margin="16,16,12,16" MinHeight="740"
                  Height="{Binding ViewportHeight, ElementName=SidebarScroll, Converter={StaticResource Subtract}, ConverterParameter=32}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Audio routing -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Width="32" Height="32" Padding="0" Click="RefreshDevices_Click"
                                    ToolTip="Refresh devices (after plugging something in)">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
                            </Button>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Audio routing" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="You hear it on" />
                        <ComboBox x:Name="MonitorDevice" HorizontalAlignment="Stretch" SelectionChanged="MonitorDevice_Changed"
                                  ToolTip="Your headphones or speakers" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Margin="2,0,10,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="&#xE767;" />
                            <TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Value, ElementName=MonitorVolume, StringFormat={}{0:P0}}" />
                            <Slider x:Name="MonitorVolume" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                    ToolTip="What you hear" ValueChanged="MonitorVolume_Changed" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Virtual mic output" Margin="0,14,0,5" />
                        <ComboBox x:Name="VirtualMicDevice" HorizontalAlignment="Stretch" SelectionChanged="VirtualMicDevice_Changed"
                                  ToolTip="Pick the virtual cable's playback side, e.g. &quot;CABLE Input (VB-Audio Virtual Cable)&quot;" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Margin="2,0,10,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="&#xE767;" />
                            <TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Value, ElementName=VirtualMicVolume, StringFormat={}{0:P0}}" />
                            <Slider x:Name="VirtualMicVolume" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                    ToolTip="What others hear" ValueChanged="VirtualMicVolume_Changed" />
                        </DockPanel>
                        <Button x:Name="InstallCableButton" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                Style="{DynamicResource AccentButtonStyle}" Content="Install VB-Cable…"
                                Click="InstallCable_Click" Visibility="Collapsed"
                                ToolTip="Downloads the free VB-Audio Virtual Cable driver from vb-audio.com and runs its installer" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Your mic (passthrough)" Margin="0,14,0,5" />
                        <ComboBox x:Name="MicrophoneDevice" HorizontalAlignment="Stretch" SelectionChanged="MicrophoneDevice_Changed"
                                  ToolTip="Mixes your real mic into the virtual mic so Discord hears your voice too" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Margin="2,0,10,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="&#xE720;" />
                            <Ellipse x:Name="MicDot" DockPanel.Dock="Right" Width="8" Height="8" Fill="#5A5C66" Margin="12,0,4,0"
                                     VerticalAlignment="Center" />
                            <ProgressBar x:Name="MicLevel" Height="4" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                         Foreground="#3FB950"
                                         ToolTip="Your mic level (what's being mixed into the virtual mic)" />
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0"
                                   ToolTip="Makes your mic louder in the virtual mic, so quiet sounds get through. Loud peaks are rounded off rather than clipped.">
                            <TextBlock DockPanel.Dock="Left" Text="Boost" Width="44" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="MicBoostText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Off" />
                            <Slider x:Name="MicBoost" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" ValueChanged="MicBoost_Changed" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Clip recorder: the app list takes whatever height is left and scrolls; the buttons stay in view. -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="72" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="RecDot" Width="8" Height="8" Fill="#E5484D" Margin="0,0,6,0"
                                         VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Clip recorder" />
                        </DockPanel>

                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Apps to record" />
                        <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <TextBlock x:Name="ClipAppsEmpty" Style="{StaticResource Hint}" Margin="12,10"
                                           Text="No apps have audio open yet. They appear here as soon as they do." />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="ClipApps" Margin="10,4" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ClipAppRow}">
                                                <DockPanel Margin="0,1">
                                                    <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="8,0,2,0"
                                                             VerticalAlignment="Center" Fill="#3FB950"
                                                             Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"
                                                             ToolTip="Has audio open right now" />
                                                    <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}" MinHeight="32" Padding="8,0,0,0" VerticalContentAlignment="Center"
                                                              ToolTip="Untick to leave this app out of clips">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}"
                                                                       Style="{StaticResource Hint}" FontSize="11" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Apps that open audio later are added ticked." />

                        <DockPanel Grid.Row="4" Margin="0,12,0,0">
                            <ComboBox x:Name="ClipLength" DockPanel.Dock="Right" Width="170" SelectionChanged="ClipLength_Changed"
                                      ToolTip="How much audio is kept in memory. Applies the next time the recorder turns on." />
                            <TextBlock Text="Keep last" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>

                        <Grid Grid.Row="5" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="ClipToggle" Style="{StaticResource RecordToggle}"
                                          Checked="ClipToggle_Checked" Unchecked="ClipToggle_Unchecked"
                                          ToolTip="Keeps the ticked apps' recent audio in memory so you can save clips">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7C8;" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock x:Name="ClipToggleText" Text="Start recording" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button x:Name="SaveClipButton" Grid.Column="2" Height="36" HorizontalAlignment="Stretch"
                                    Style="{DynamicResource AccentButtonStyle}" IsEnabled="False" Click="SaveClip_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" Margin="0,0,8,0" />
                                    <TextBlock x:Name="SaveClipText" Text="Clip 30 s…" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="ClipStatus" Grid.Row="6" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Start recording to keep the ticked apps' recent audio for clips." />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ================= Main: sound pads ================= -->
        <Grid Grid.Column="1" Margin="8,16,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,4,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Padding="12,6" Click="StopAll_Click" ToolTip="Stop every sound (your mic keeps going)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Stop all" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,0" Padding="12,6" Click="ExportAll_Click"
                            ToolTip="Copy every sound's file into a folder, named after its pad">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Export all…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Padding="12,6" Style="{DynamicResource AccentButtonStyle}" Click="AddSounds_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Add sounds…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sounds" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                               Text="Click to play. Drag out to copy. Right-click to edit and more." />
                </StackPanel>
            </DockPanel>

            <!-- Empty state -->
            <Border x:Name="EmptyHint" Grid.Row="1" Margin="0,0,0,16" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No sounds yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" TextAlignment="Center"
                               Text="Drop audio files here, or add them from your computer. MP3, WAV, OGG, Opus, M4A, AIFF and WMA work." />
                    <Button HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,7"
                            Style="{DynamicResource AccentButtonStyle}" Content="Add sounds…" Click="AddSounds_Click" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Pads" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SoundItem}">
                            <Button Style="{StaticResource Pad}" Click="Pad_Click" ToolTip="{Binding Path}"
                                    PreviewMouseLeftButtonDown="Pad_PreviewMouseLeftButtonDown" PreviewMouseMove="Pad_PreviewMouseMove"
                                    Background="{Binding Path, Converter={StaticResource PadColor}}">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="58" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename…" Click="RenamePad_Click">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Edit… (trim, effects)" Click="TrimPad_Click">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Make reversed copy" Click="ReversePad_Click">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Export…" Click="ExportPad_Click">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copy file" Click="CopyPadFile_Click">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Show in File Explorer" Click="ShowPadInExplorer_Click">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Remove" Click="RemovePad_Click">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" Padding="16,7"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <TextBlock x:Name="Status" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
