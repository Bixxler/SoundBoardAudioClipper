<Window x:Class="Soundboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Soundboard"
        Title="Soundboard" Height="560" Width="860" MinWidth="560" MinHeight="380"
        Background="#1E1F24" Foreground="#E8E8EC" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#A6A8B3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Width" Value="110" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style TargetType="Button" x:Key="Toolbar">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="Button" x:Key="Pad">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="84" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Foreground" Value="#F4F4F6" />
            <Setter Property="Background" Value="#3A4D8F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4A61B0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C3B6E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Device routing -->
        <Border DockPanel.Dock="Top" Background="#26272D" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource Label}" Text="You hear it on" />
                <ComboBox x:Name="MonitorDevice" Grid.Column="1" SelectionChanged="MonitorDevice_Changed" />
                <Slider x:Name="MonitorVolume" Grid.Column="2" ToolTip="Monitor volume" ValueChanged="MonitorVolume_Changed" />

                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Virtual mic output" />
                <ComboBox x:Name="VirtualMicDevice" Grid.Row="1" Grid.Column="1" SelectionChanged="VirtualMicDevice_Changed"
                          ToolTip="Pick the virtual cable's playback side, e.g. &quot;CABLE Input (VB-Audio Virtual Cable)&quot;" />
                <Slider x:Name="VirtualMicVolume" Grid.Row="1" Grid.Column="2" ToolTip="Volume others hear" ValueChanged="VirtualMicVolume_Changed" />

                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Your mic (passthrough)" />
                <ComboBox x:Name="MicrophoneDevice" Grid.Row="2" Grid.Column="1" SelectionChanged="MicrophoneDevice_Changed"
                          ToolTip="Mixes your real mic into the virtual mic so Discord hears your voice too" />
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse x:Name="MicDot" Width="8" Height="8" Fill="#5A5C66" Margin="0,0,6,0" />
                    <ProgressBar x:Name="MicLevel" Width="96" Height="6" Minimum="0" Maximum="1"
                                 Background="#33343B" Foreground="#3FB950" BorderThickness="0"
                                 ToolTip="Your mic level (what's being mixed into the virtual mic)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,12,16,4">
            <Button Style="{StaticResource Toolbar}" Content="Add sounds…" Click="AddSounds_Click" />
            <Button Style="{StaticResource Toolbar}" Content="■  Stop all" Click="StopAll_Click" />
            <Button Style="{StaticResource Toolbar}" Content="Refresh devices" Click="RefreshDevices_Click" />
            <Button x:Name="InstallCableButton" Style="{StaticResource Toolbar}" Content="Install VB-Cable…"
                    Click="InstallCable_Click" Visibility="Collapsed"
                    ToolTip="Downloads the free VB-Audio Virtual Cable driver from vb-audio.com and runs its installer" />
        </StackPanel>

        <!-- Clip recorder -->
        <Border DockPanel.Dock="Top" Margin="16,8,16,4" Padding="12,8" Background="#26272D" CornerRadius="6">
            <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="Record from" />
                <ComboBox x:Name="ClipLength" DockPanel.Dock="Right" Width="150" SelectionChanged="ClipLength_Changed"
                          ToolTip="How much audio is kept in memory. Longer buffers use more memory. Applies the next time the recorder turns on." />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Margin="16,0,8,0" Text="Keep last" />
                <Button DockPanel.Dock="Right" Padding="10,3" Margin="8,3,0,3" Content="⟳" Click="RefreshClipSources_Click"
                        x:Name="RefreshClipSourcesButton" ToolTip="Refresh the list of open windows" />
                <ComboBox x:Name="ClipSource" DropDownOpened="ClipSource_DropDownOpened" SelectionChanged="ClipSource_Changed"
                          ToolTip="The app whose audio is recorded. Every window and tab of that app is included; nothing else is." />
            </DockPanel>
            <DockPanel>
                <ToggleButton x:Name="ClipToggle" DockPanel.Dock="Left" Padding="12,5" Content="Clip recorder: Off"
                              Checked="ClipToggle_Checked" Unchecked="ClipToggle_Unchecked"
                              ToolTip="Keeps the last few seconds or minutes of the chosen app's audio in memory so you can save clips" />
                <Button x:Name="SaveClipButton" DockPanel.Dock="Right" Padding="12,5" Content="✂  Clip last 30 s…"
                        IsEnabled="False" Click="SaveClip_Click" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="#E5484D" Margin="0,0,8,0" Visibility="Collapsed" />
                    <TextBlock x:Name="ClipStatus" Foreground="#A6A8B3" TextTrimming="CharacterEllipsis"
                               Text="Off. Pick a window, then turn it on to capture that app's audio for clips." />
                </StackPanel>
            </DockPanel>
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border DockPanel.Dock="Bottom" Background="#26272D" Padding="16,6">
            <TextBlock x:Name="Status" Foreground="#A6A8B3" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Sound pads -->
        <Grid Margin="10,4,10,10">
            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#7C7E8A" TextAlignment="Center" FontSize="14"
                       Text="Drop audio files here or click &quot;Add sounds…&quot;&#x0a;(mp3, wav, aiff, wma, m4a)" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Pads">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SoundItem}">
                            <Button Style="{StaticResource Pad}" Click="Pad_Click" ToolTip="{Binding Path}">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename…" Click="RenamePad_Click" />
                                        <MenuItem Header="Trim…" Click="TrimPad_Click" />
                                        <Separator />
                                        <MenuItem Header="Remove" Click="RemovePad_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
